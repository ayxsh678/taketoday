# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/taketoday

# JWT Authentication for Internal Services
INTERNAL_SERVICE_TOKEN=your-super-secret-internal-token-here

# Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Service Configuration
PORT=8000
HOST=0.0.0.0

# Logging Level
LOG_LEVEL=INFO

# Scheduler Configuration
SCRAPING_INTERVAL_HOURS=2

# Social Media Platform Credentials (example format)
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
