# Upstash Redis — required for durable rate limiting across serverless instances
# Create a free database at https://console.upstash.com and copy REST credentials
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Resend — transactional email (password reset, email verification)
# Get an API key at https://resend.com (free tier: 3000 emails/month)
# Also verify your sending domain at resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-shared-service-token

