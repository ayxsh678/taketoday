NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me
AUTH_GOOGLE_ID=replace-me
AUTH_GOOGLE_SECRET=replace-me

ADMIN_EMAILS=founder@taketoday.com,editor@taketoday.com
ADMIN_SUPER_ADMINS=founder@taketoday.com
ADMIN_EDITORS=editor@taketoday.com
ADMIN_CONTENT_MANAGERS=content@taketoday.com
ADMIN_SOCIAL_MANAGERS=social@taketoday.com

DATABASE_URL=postgresql://postgres:password@localhost:5432/taketoday

# Upstash Redis — required for durable rate limiting across serverless instances
# Create a free database at https://console.upstash.com and copy REST credentials
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Resend — transactional email (password reset, email verification)
# Get an API key at https://resend.com (free tier: 3000 emails/month)
# Also verify your sending domain at resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-shared-service-token

# Studio — Instagram (Meta Graph API v21)
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Studio — Twitter/X (OAuth 1.0a)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Studio — LinkedIn
LINKEDIN_ACCESS_TOKEN=
