generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  role           AdminRole       @default(EDITOR)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  articles       Article[]
  auditLogs      AuditLog[]
  contentDrafts  ContentDraft[]
}

model Article {
  id              String        @id @default(cuid())
  headline        String
  slug            String        @unique
  body            String        @default("")
  excerpt         String?
  featuredImageId String?
  authorId        String
  categoryId      String?
  status          ArticleStatus @default(DRAFT)
  breaking        Boolean       @default(false)
  seoTitle        String?
  seoDescription  String?
  metaKeywords    String[]      @default([])
  views           Int           @default(0)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author        AdminUser    @relation(fields: [authorId], references: [id])
  featuredImage MediaAsset?  @relation(fields: [featuredImageId], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])
  tags          ArticleTag[]

  @@index([status, publishedAt])
  @@index([scheduledAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  assets    MediaAsset[]
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
}

model MediaAsset {
  id        String       @id @default(cuid())
  folderId  String?
  url       String
  publicId  String
  altText   String?
  bytes     Int          @default(0)
  width     Int?
  height    Int?
  createdAt DateTime     @default(now())
  articles  Article[]
  folder    MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime   @default(now())
  actor     AdminUser? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model ContentDraft {
  id          String          @id @default(cuid())
  type        DraftType
  topic       String
  payload     Json
  createdById String?
  createdAt   DateTime        @default(now())
  createdBy   AdminUser?      @relation(fields: [createdById], references: [id])
  posts       ScheduledPost[]

  @@map("content_drafts")
}

model ScheduledPost {
  id             String        @id @default(cuid())
  draftId        String?
  platform       PostPlatform
  content        String
  mediaUrls      String[]      @default([])
  scheduledAt    DateTime?
  status         PostStatus    @default(PENDING)
  platformPostId String?
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime      @default(now())
  draft          ContentDraft? @relation(fields: [draftId], references: [id])

  @@index([status, scheduledAt])
  @@map("scheduled_posts")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum DraftType {
  CAROUSEL
  REEL_SCRIPT
}

enum PostPlatform {
  INSTAGRAM
  TWITTER
  LINKEDIN
  WHATSAPP
}

enum PostStatus {
  PENDING
  POSTED
  FAILED
}
