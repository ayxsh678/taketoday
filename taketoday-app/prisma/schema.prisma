generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  role               AdminRole           @default(ANALYST)
  image              String?
  twoFactorReady     Boolean             @default(false)
  revokedAt          DateTime?
  lastActiveAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  articles           Article[]           @relation("ArticleAuthor")
  auditLogs          AuditLog[]
  comments           ReviewComment[]
  editorialDecisions EditorialDecision[]
}

model Article {
  id              String            @id @default(cuid())
  headline        String
  subheadline     String
  slug            String            @unique
  body            String
  featuredImageId String?
  sourceLink      String?
  authorId        String
  status          ArticleStatus     @default(DRAFT)
  language        String            @default("en")
  location        String?
  breaking        Boolean           @default(false)
  priorityScore   Int               @default(50)
  seoTitle        String?
  seoDescription  String?
  metaKeywords    String[]          @default([])
  canonicalUrl    String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  captions        Json?
  publishLogs     Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sourceId        String?
  analyticsEvents AnalyticsEvent[]
  author          AdminUser         @relation("ArticleAuthor", fields: [authorId], references: [id])
  featuredImage   MediaAsset?       @relation(fields: [featuredImageId], references: [id])
  source          Source?           @relation(fields: [sourceId], references: [id])
  categories      ArticleCategory[]
  gallery         ArticleGallery[]
  tags            ArticleTag[]
  reviewComments  ReviewComment[]
  socialPosts     SocialPost[]

  @@index([status, publishedAt])
  @@index([priorityScore])
  @@index([scheduledAt])         // cron publish query
  @@index([authorId])
  @@index([createdAt])
}

model Category {
  id           String            @id @default(cuid())
  name         String            @unique
  slug         String            @unique
  description  String?
  icon         String?
  displayOrder Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  articles     ArticleCategory[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
  assets   MediaTag[]
}

model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  assets    MediaAsset[]
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
}

model MediaAsset {
  id           String           @id @default(cuid())
  folderId     String?
  url          String
  secureUrl    String
  publicId     String
  resourceType String
  format       String
  width        Int?
  height       Int?
  bytes        Int
  altText      String?
  createdAt    DateTime         @default(now())
  featuredFor  Article[]
  galleryFor   ArticleGallery[]
  folder       MediaFolder?     @relation(fields: [folderId], references: [id])
  tags         MediaTag[]
}

model MediaTag {
  mediaId String
  tagId   String
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model ArticleGallery {
  articleId String
  mediaId   String
  sortOrder Int        @default(0)
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
}

model IngestionSource {
  id                String         @id @default(cuid())
  name              String
  type              String
  url               String
  active            Boolean        @default(true)
  trustScore        Int            @default(70)
  trustedCategories String[]       @default([])
  createdAt         DateTime       @default(now())
  jobs              IngestionJob[]
}

model IngestionJob {
  id          String           @id @default(cuid())
  sourceId    String?
  type        String
  input       String
  status      JobStatus        @default(QUEUED)
  duplicateOf String?
  result      Json?
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  source      IngestionSource? @relation(fields: [sourceId], references: [id])
}

model Source {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  type        String
  active      Boolean   @default(true)
  lastScraped DateTime?
  articles    Article[]
}

model Job {
  id             String    @id @default(cuid())
  type           String
  status         JobStatus @default(PENDING)
  result         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  retryCount     Int       @default(0)
  idempotencyKey String?   @unique
  userId         String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

model SocialPost {
  id          String         @id @default(cuid())
  articleId   String?
  platform    SocialPlatform
  copy        String
  mediaIds    String[]       @default([])
  status      JobStatus      @default(QUEUED)
  scheduledAt DateTime?
  publishedAt DateTime?
  retryCount  Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  article     Article?       @relation(fields: [articleId], references: [id])
}

model ShortVideoJob {
  id             String    @id @default(cuid())
  script         String
  voiceProvider  String?
  avatarProvider String?
  templateId     String?   @default("taketoday-news")
  subtitleUrl    String?
  status         JobStatus @default(QUEUED)
  publishQueue   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ReviewComment {
  id        String    @id @default(cuid())
  articleId String
  authorId  String
  body      String
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    AdminUser @relation(fields: [authorId], references: [id])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  articleId String?
  type      String
  source    String?
  value     Float
  metadata  Json?
  createdAt DateTime @default(now())
  article   Article? @relation(fields: [articleId], references: [id])

  @@index([type, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  kind      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Integration {
  id        String              @id @default(cuid())
  provider  IntegrationProvider
  name      String
  enabled   Boolean             @default(false)
  config    Json?
  secretRef String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([provider, name])
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime   @default(now())
  actor     AdminUser? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  CONTENT_MANAGER
  SOCIAL_MEDIA_MANAGER
  ANALYST
}

enum ArticleStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  CLOUDINARY
  X
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
}

enum SocialPlatform {
  X
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  THREADS
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
}

// ─── OPEN JOURNALISM PLATFORM ─────────────────────────────────────────────────

model PublicUser {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  username             String                    @unique
  displayName          String
  avatar               String?
  bio                  String?
  location             String?
  website              String?
  twitterHandle        String?
  linkedinUrl          String?
  emailVerified        DateTime?
  passwordHash         String?
  twoFactorEnabled     Boolean                   @default(false)
  twoFactorSecret      String?
  role                 ContributorRole           @default(CONTRIBUTOR)
  isVerifiedJournalist Boolean                   @default(false)
  verifiedExpertise    String[]                  @default([])
  suspendedAt          DateTime?
  suspendedReason      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  contributions             Contribution[]             @relation("ContributionAuthor")
  collaborations            ContributionCollaborator[]
  factChecks                FactCheck[]
  communityVotes            CommunityVote[]
  communityNotes            CommunityNote[]
  evidenceSubmissions       Evidence[]
  reputation                ContributorReputation?
  investigationMemberships  InvestigationMember[]
  notifications             ContributorNotification[]

  // Phase D — Contributor Economy
  streaks                   ContributorStreak[]
  reputationDimensions      ReputationDimension?
  reputationEvents          ReputationEvent[]
  userBadges                UserBadge[]
  expertiseDomains          ExpertiseDomain[]
  missionParticipants       MissionParticipant[]
  leaderboardEntries        LeaderboardEntry[]
  activities                ContributorActivity[]
  civicImpacts              CivicImpact[]
  endorsementsGiven         ContributorEndorsement[]   @relation("EndorsementFrom")
  endorsementsReceived      ContributorEndorsement[]   @relation("EndorsementTo")
  trustFlags                TrustFlag[]

  @@index([username])
  @@index([role])
  @@index([createdAt])
}

model Contribution {
  id                 String                 @id @default(cuid())
  authorId           String
  type               ContributionType
  title              String
  slug               String                 @unique
  summary            String?
  body               String
  status             ContributionStatus     @default(DRAFT)
  workflowStage      WorkflowStage          @default(DRAFT)
  parentId           String?
  rootId             String?
  branchName         String?
  confidenceScore    Float?
  riskScore          Float?
  biasScore          Float?
  aiUsageDisclosed   Boolean                @default(false)
  aiSummary          String?
  language           String                 @default("en")
  location           String?
  isBreaking         Boolean                @default(false)
  isWhistleblower    Boolean                @default(false)
  publishedArticleId String?
  categoryId         String?
  tags               String[]               @default([])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  publishedAt        DateTime?

  author             PublicUser             @relation("ContributionAuthor", fields: [authorId], references: [id])
  parent             Contribution?          @relation("ContributionFork", fields: [parentId], references: [id])
  forks              Contribution[]         @relation("ContributionFork")
  versions           ContributionVersion[]
  collaborators      ContributionCollaborator[]
  evidence           Evidence[]
  citations          CitationNode[]
  factChecks         FactCheck[]
  communityVotes     CommunityVote[]
  communityNotes     CommunityNote[]
  transparencyLogs   TransparencyLog[]
  aiAnalysis         AIAnalysis?
  embedding          ContributionEmbedding?
  editorialDecisions EditorialDecision[]
  corrections        Correction[]
  civicImpact        CivicImpact?
  missionLinks       MissionContribution[]

  @@index([status, createdAt])
  @@index([authorId])
  @@index([type])
  @@index([workflowStage])
  @@index([publishedAt])
}

model ContributionVersion {
  id             String       @id @default(cuid())
  contributionId String
  versionNumber  Int
  body           String
  title          String
  commitMessage  String?
  authorId       String?
  diff           Json?
  createdAt      DateTime     @default(now())

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([contributionId, versionNumber])
  @@index([contributionId])
}

model ContributionCollaborator {
  contributionId String
  userId         String
  role           CollaboratorRole @default(CONTRIBUTOR)
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?

  contribution   Contribution     @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user           PublicUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contributionId, userId])
}

model Evidence {
  id               String       @id @default(cuid())
  contributionId   String
  type             EvidenceType
  title            String
  description      String?
  url              String?
  fileUrl          String?
  publicId         String?
  submittedById    String
  credibilityScore Float?
  verifiedAt       DateTime?
  verifiedById     String?
  createdAt        DateTime     @default(now())

  contribution     Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  submittedBy      PublicUser   @relation(fields: [submittedById], references: [id])

  @@index([contributionId])
}

model CitationNode {
  id               String       @id @default(cuid())
  contributionId   String
  url              String
  title            String?
  excerpt          String?
  publishedAt      DateTime?
  accessedAt       DateTime     @default(now())
  reliabilityScore Float?
  type             SourceType
  archived         Boolean      @default(false)
  archiveUrl       String?

  contribution     Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([contributionId])
}

model FactCheck {
  id              String           @id @default(cuid())
  contributionId  String
  checkerId       String
  claim           String
  verdict         FactCheckVerdict
  explanation     String
  evidenceLinks   String[]         @default([])
  confidenceScore Float?
  aiAssisted      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contribution    Contribution     @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  checker         PublicUser       @relation(fields: [checkerId], references: [id])

  @@index([contributionId])
}

model CommunityVote {
  id             String       @id @default(cuid())
  contributionId String
  userId         String
  type           VoteType
  weight         Float        @default(1.0)
  createdAt      DateTime     @default(now())

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user           PublicUser   @relation(fields: [userId], references: [id])

  @@unique([contributionId, userId])
  @@index([contributionId])
}

model CommunityNote {
  id             String       @id @default(cuid())
  contributionId String
  authorId       String
  body           String
  type           NoteType
  helpful        Int          @default(0)
  notHelpful     Int          @default(0)
  status         NoteStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  author         PublicUser   @relation(fields: [authorId], references: [id])

  @@index([contributionId, status])
}

model ContributorReputation {
  id                  String         @id @default(cuid())
  userId              String         @unique
  totalContributions  Int            @default(0)
  publishedCount      Int            @default(0)
  factCheckAccuracy   Float          @default(0)
  communityTrustScore Float          @default(0)
  editorialTrustScore Float          @default(0)
  overallScore        Float          @default(0)
  tier                ReputationTier @default(NEWCOMER)
  expertiseTopics     String[]       @default([])
  strikes             Int            @default(0)
  badges              Json           @default("[]")
  lastRecalculatedAt  DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user                PublicUser     @relation(fields: [userId], references: [id])
}

model TransparencyLog {
  id             String             @id @default(cuid())
  contributionId String
  action         TransparencyAction
  actorId        String?
  actorType      String
  description    String
  metadata       Json?
  createdAt      DateTime           @default(now())

  contribution   Contribution       @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([contributionId])
  @@index([createdAt])
}

model AIAnalysis {
  id                  String       @id @default(cuid())
  contributionId      String       @unique
  biasScore           Float?
  biasDetails         Json?
  misinformationRisk  Float?
  duplicateSimilarity Float?
  duplicateOf         String?
  suggestedKeywords   String[]     @default([])
  suggestedHeadlines  String[]     @default([])
  readabilityScore    Float?
  sentimentScore      Float?
  sentimentLabel      String?
  factClaimsExtracted Json?
  languageDetected    String?
  translatedSummaries Json?
  seoTitle            String?
  seoDescription      String?
  contentWarnings     String[]     @default([])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  contribution        Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model EditorialDecision {
  id              String       @id @default(cuid())
  contributionId  String
  decisionType    DecisionType
  reason          String
  notes           String?
  editorId        String
  publiclyVisible Boolean      @default(false)
  createdAt       DateTime     @default(now())

  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  editor          AdminUser    @relation(fields: [editorId], references: [id])

  @@index([contributionId])
}

model Correction {
  id               String             @id @default(cuid())
  contributionId   String
  description      String
  previousContent  String?
  correctedContent String?
  severity         CorrectionSeverity
  correctedById    String
  correctedByType  String
  createdAt        DateTime           @default(now())

  contribution     Contribution       @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([contributionId])
}

model Investigation {
  id           String              @id @default(cuid())
  leaderId     String
  leaderType   String
  title        String
  slug         String              @unique
  description  String?
  status       InvestigationStatus @default(ACTIVE)
  isPublic     Boolean             @default(false)
  targetEntity String?
  tags         String[]            @default([])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  members      InvestigationMember[]
  boards       ResearchBoard[]

  @@index([status])
  @@index([leaderId])
}

model InvestigationMember {
  investigationId String
  userId          String
  role            InvestigationRole @default(RESEARCHER)
  joinedAt        DateTime          @default(now())

  investigation   Investigation     @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  user            PublicUser        @relation(fields: [userId], references: [id])

  @@id([investigationId, userId])
}

// Vector column (embedding) is NOT declared here — it's added via raw SQL migration
// so Prisma doesn't need to know the vector type. Queries use prisma.$queryRaw.
model ContributionEmbedding {
  id             String   @id @default(cuid())
  contributionId String   @unique
  model          String   @default("text-embedding-3-small")
  dimensions     Int      @default(1536)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model ResearchBoard {
  id              String         @id @default(cuid())
  investigationId String
  name            String
  description     String?
  columns         Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  investigation   Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  cards           ResearchCard[]

  @@index([investigationId])
}

model ResearchCard {
  id             String        @id @default(cuid())
  boardId        String
  columnId       String
  type           CardType
  title          String
  body           String?
  position       Int           @default(0)
  assignedToId   String?
  contributionId String?
  evidenceIds    String[]      @default([])
  tags           String[]      @default([])
  priority       CardPriority  @default(MEDIUM)
  resolved       Boolean       @default(false)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  board          ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, columnId])
  @@index([type])
}

model ContributorNotification {
  id        String     @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  metadata  Json?
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      PublicUser @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

// ─── NEW ENUMS ────────────────────────────────────────────────────────────────

