  ORGANIZATION
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── PHASE D — CONTRIBUTOR ECONOMY ────────────────────────────────────────────

model ContributorStreak {
  id             String     @id @default(cuid())
  userId         String
  activityType   StreakType
  currentStreak  Int        @default(0)
  longestStreak  Int        @default(0)
  lastActivityAt DateTime?
  graceUsedAt    DateTime?
  freezesLeft    Int        @default(2)
  milestoneHits  Int[]      @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityType])
  @@index([userId])
}

model ReputationDimension {
  id                  String     @id @default(cuid())
  userId              String     @unique
  reportingScore      Float      @default(0)
  factCheckScore      Float      @default(0)
  researchScore       Float      @default(0)
  moderationScore     Float      @default(0)
  accuracyScore       Float      @default(0)
  sourceScore         Float      @default(0)
  collaborationScore  Float      @default(0)
  communityScore      Float      @default(0)
  overallScore        Float      @default(0)
  fraudRiskScore      Float      @default(0)
  lastDecayAt         DateTime?
  updatedAt           DateTime   @updatedAt

  user                PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReputationEvent {
  id         String       @id @default(cuid())
  userId     String
  dimension  RepDimension
  delta      Float
  reason     String
  sourceId   String?
  sourceType String?
  createdAt  DateTime     @default(now())

  user       PublicUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BadgeDefinition {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  rarity      BadgeRarity
  category    BadgeCategory
  criteria    Json
  isActive    Boolean       @default(true)
  isSeasonal  Boolean       @default(false)
  seasonEndAt DateTime?
  createdAt   DateTime      @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id            String          @id @default(cuid())
  userId        String
  badgeId       String
  earnedAt      DateTime        @default(now())
  metadata      Json?
  isShowcased   Boolean         @default(false)
  showcaseOrder Int?

  user          PublicUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge         BadgeDefinition @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

model ExpertiseDomain {
  id            String     @id @default(cuid())
  userId        String
  topic         String
  score         Float      @default(0)
  contributions Int        @default(0)
  updatedAt     DateTime   @updatedAt

  user          PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([topic, score])
}

model Mission {
  id            String               @id @default(cuid())
  title         String
  description   String
  type          MissionType
  status        MissionStatus        @default(ACTIVE)
  targetCount   Int
  currentCount  Int                  @default(0)
  region        String?
  topic         String?
  rewardBadgeId String?
  rewardPoints  Int                  @default(0)
  startsAt      DateTime             @default(now())
  endsAt        DateTime
  createdBy     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  participants  MissionParticipant[]
  contributions MissionContribution[]

  @@index([status, endsAt])
}

model MissionParticipant {
  id          String     @id @default(cuid())
  missionId   String
  userId      String
  progress    Int        @default(0)
  joinedAt    DateTime   @default(now())
  completedAt DateTime?

  mission     Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId])
}

model MissionContribution {
  id             String       @id @default(cuid())
  missionId      String
  contributionId String
  userId         String
  createdAt      DateTime     @default(now())

  mission        Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([missionId, contributionId])
  @@index([missionId])
}

model LeaderboardEntry {
  id          String          @id @default(cuid())
  boardType   LeaderboardType
  scope       String
  userId      String
  rank        Int
  score       Float
  metadata    Json?
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime        @updatedAt

  user        PublicUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardType, scope, userId])
  @@index([boardType, scope, rank])
}

model ContributorActivity {
  id         String       @id @default(cuid())
  userId     String
  type       ActivityType
  targetId   String?
  targetType String?
  metadata   Json?
  isPublic   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  user       PublicUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model CivicImpact {
  id                 String       @id @default(cuid())
  contributionId     String       @unique
  userId             String
  viewCount          Int          @default(0)
  governmentResponse Boolean      @default(false)
  communityResponse  Boolean      @default(false)
  correctionIssued   Boolean      @default(false)
  impactScore        Float        @default(0)
  impactStatement    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  contribution       Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user               PublicUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContributorEndorsement {
  id         String     @id @default(cuid())
  fromUserId String
  toUserId   String
  domain     String
  note       String?
  createdAt  DateTime   @default(now())

  fromUser   PublicUser @relation("EndorsementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     PublicUser @relation("EndorsementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, domain])
  @@index([toUserId])
}

model TrustFlag {
  id         String        @id @default(cuid())
  userId     String
  flagType   TrustFlagType
  severity   Float
  details    Json?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime      @default(now())

  user       PublicUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flagType, resolvedAt])
}

// ─── PHASE D ENUMS ─────────────────────────────────────────────────────────────

enum StreakType {
  DAILY_CONTRIBUTION
  WEEKLY_PUBLISHING
  FACT_CHECKING
  EVIDENCE_UPLOAD
  SOURCE_VERIFICATION
  RESEARCH_COLLABORATION
  TRANSLATION
  COMMUNITY_MODERATION
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeCategory {
  REPORTING
  FACT_CHECKING
  INVESTIGATION
  COMMUNITY
  ACCURACY
  STREAK
  MILESTONE
  SEASONAL
  SPECIAL
}

enum MissionType {
  FACT_CHECK_CAMPAIGN
  REGIONAL_COVERAGE
  CRISIS_COVERAGE
  ELECTION_MONITORING
  INVESTIGATION_SPRINT
  TRANSLATION_DRIVE
  MODERATION_PUSH
  EVIDENCE_COLLECTION
}

enum MissionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LeaderboardType {
  OVERALL
  REPORTING
  FACT_CHECKING
  INVESTIGATION
  ACCURACY
  COMMUNITY
  RISING
}

enum ActivityType {
  CONTRIBUTION_PUBLISHED
  FACT_CHECK_COMPLETED
  BADGE_EARNED
  STREAK_MILESTONE
  MISSION_JOINED
  MISSION_COMPLETED
  INVESTIGATION_JOINED
  EVIDENCE_SUBMITTED
  NOTE_PROMOTED
  CORRECTION_ISSUED
}

enum RepDimension {
  REPORTING
  FACT_CHECK
  RESEARCH
  MODERATION
  ACCURACY
  SOURCE
  COLLABORATION
  COMMUNITY
}

enum TrustFlagType {
  SPAM_FARMING
  COORDINATED_MANIPULATION
  AI_GENERATED_JUNK
  VOTE_BRIGADING
  REPUTATION_ABUSE
  SYBIL_SUSPECTED
  QUALITY_BREACH
}

// ─── PHASE E — MULTI-PROVIDER AI ORCHESTRATION ─────────────────────────────────

enum AITaskType {
  ARTICLE_GENERATION
  CAROUSEL_GENERATION
  SHORT_VIDEO_SCRIPT
  SOCIAL_CAPTION
  HEADLINE_VARIANTS
  SEO_METADATA
  SUMMARIZATION
  REWRITE
  DISTRIBUTION_POST
  FACT_CHECK
  TRANSLATION
  ANALYSIS
}

model AIProviderSetting {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isEnabled Boolean  @default(true)
  priority  Int      @default(5)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AITaskRoute {
  id        String     @id @default(cuid())
  taskType  AITaskType @unique
  providers Json
  isActive  Boolean    @default(true)
  updatedAt DateTime   @updatedAt
  updatedBy String?
}

model AIUsageEvent {
  id           String     @id @default(cuid())
  taskType     AITaskType
  provider     String
  model        String
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  costUsd      Float?
  latencyMs    Int        @default(0)
  success      Boolean    @default(true)
  error        String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([taskType])
  @@index([provider])
  @@index([createdAt])
}
