generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  CONTENT_MANAGER
  SOCIAL_MEDIA_MANAGER
  ANALYST
}

enum ArticleStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  CLOUDINARY
  X
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
}

enum SocialPlatform {
  X
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}

model AdminUser {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  role          AdminRole   @default(ANALYST)
  image         String?
  twoFactorReady Boolean    @default(false)
  revokedAt     DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  articles      Article[]   @relation("ArticleAuthor")
  auditLogs     AuditLog[]
  comments      ReviewComment[]
}

model Article {
  id              String        @id @default(cuid())
  headline        String
  subheadline     String
  slug            String        @unique
  body            String
  featuredImageId String?
  sourceLink      String?
  authorId        String
  status          ArticleStatus @default(DRAFT)
  language        String        @default("en")
  location        String?
  breaking        Boolean       @default(false)
  priorityScore   Int           @default(50)
  seoTitle        String?
  seoDescription  String?
  metaKeywords    String[]      @default([])
  canonicalUrl    String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  author          AdminUser     @relation("ArticleAuthor", fields: [authorId], references: [id])
  featuredImage   MediaAsset?   @relation(fields: [featuredImageId], references: [id])
  categories      ArticleCategory[]
  tags            ArticleTag[]
  gallery         ArticleGallery[]
  socialPosts     SocialPost[]
  reviewComments  ReviewComment[]
  analyticsEvents AnalyticsEvent[]

  @@index([status, publishedAt])
  @@index([priorityScore])
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  description  String?
  icon         String?        // emoji or icon name
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  articles     ArticleCategory[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
  assets   MediaTag[]
}

model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model MediaFolder {
  id        String       @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder? @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
}

model MediaAsset {
  id          String           @id @default(cuid())
  folderId    String?
  url         String
  secureUrl   String
  publicId    String
  resourceType String
  format      String
  width       Int?
  height      Int?
  bytes       Int
  altText     String?
  folder      MediaFolder?     @relation(fields: [folderId], references: [id])
  tags        MediaTag[]
  featuredFor Article[]
  galleryFor  ArticleGallery[]
  createdAt   DateTime         @default(now())
}

model MediaTag {
  mediaId String
  tagId   String
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model ArticleGallery {
  articleId String
  mediaId   String
  sortOrder Int      @default(0)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
}

model IngestionSource {
  id          String    @id @default(cuid())
  name        String
  type        String
  url         String
  active      Boolean   @default(true)
  trustScore  Int       @default(70)
  jobs        IngestionJob[]
  createdAt   DateTime  @default(now())
}

model IngestionJob {
  id          String          @id @default(cuid())
  sourceId    String?
  type        String
  input       String
  status      JobStatus       @default(QUEUED)
  duplicateOf String?
  result      Json?
  error       String?
  source      IngestionSource? @relation(fields: [sourceId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Source {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  type        String   // rss, website, api
  active      Boolean  @default(true)
  lastScraped DateTime?
  articles    Article[]
}

model Job {
  id          String    @id @default(cuid())
  type        String    // scrape, pipeline, generate-headlines
  status      JobStatus @default(PENDING)
  result      Json?
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  userId      String?
  createdAt   DateTime  @default(now())
}

model SocialPost {
  id          String         @id @default(cuid())
  articleId   String?
  platform    SocialPlatform
  copy        String
  mediaIds    String[]       @default([])
  status      JobStatus      @default(QUEUED)
  scheduledAt DateTime?
  publishedAt DateTime?
  retryCount  Int            @default(0)
  lastError   String?
  article     Article?       @relation(fields: [articleId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ShortVideoJob {
  id            String    @id @default(cuid())
  script        String
  voiceProvider String?
  avatarProvider String?
  subtitleUrl   String?
  status        JobStatus @default(QUEUED)
  publishQueue  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReviewComment {
  id        String    @id @default(cuid())
  articleId String
  authorId  String
  body      String
  resolved  Boolean   @default(false)
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    AdminUser @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  articleId String?
  type      String
  source    String?
  value     Float
  metadata  Json?
  article   Article? @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  kind      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Integration {
  id        String              @id @default(cuid())
  provider  IntegrationProvider
  name      String
  enabled   Boolean             @default(false)
  config    Json?
  secretRef String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([provider, name])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  actor     AdminUser? @relation(fields: [actorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
